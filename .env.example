# Alert Correlation Engine Configuration

# Server Port (default: 3000)
PORT=3000

# API Registry Configuration
# Base URL of the Extreme Networks API Registry
EXTREME_REGISTRY_URL=https://api.extremecloudiq.com

# API Key for registry access (from Extreme Networks)
EXTREME_API_KEY=your-api-key-here

# Alert Retention (in milliseconds, default: 24 hours)
ALERT_RETENTION_MS=86400000

# ML Model Configuration
ML_PATTERN_FREQUENCY_THRESHOLD=2
ML_ANOMALY_THRESHOLD=60

# Webhook Configuration (for external integrations)
WEBHOOK_TIMEOUT=5000

# Environment
NODE_ENV=production
