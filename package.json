{
  "name": "alert-correlation-engine",
  "version": "0.1.0",
  "description": "Intelligent alert correlation and troubleshooting engine for Extreme Networks",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:ui": "cd ui && CI=false npm install --legacy-peer-deps && npm run build",
    "build:backend": "npm install && npm run build",
    "build:all": "npm run build:backend && npm run build:ui",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "alerts",
    "correlation",
    "troubleshooting",
    "extreme-networks",
    "monitoring"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.2",
    "typescript": "^4.9.5",
    "ts-node": "^10.9.1",
    "@types/jest": "^29.5.2",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "simple-statistics": "^7.8.3",
    "ml-kmeans": "^4.1.1",
    "eslint": "^8.43.0",
    "@typescript-eslint/eslint-plugin": "^5.59.6",
    "@typescript-eslint/parser": "^5.59.6"
  }
}
