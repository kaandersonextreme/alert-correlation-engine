{\n  \"name\": \"alert-correlation-engine\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Intelligent alert correlation and troubleshooting engine for Extreme Networks\",\n  \"main\": \"dist/index.js\",\n  \"scripts\": {\n    \"build\": \"npm run build:all\",\n    \"build:ui\": \"cd ui && CI=false npm ci --legacy-peer-deps && npm run build\",\n    \"build:backend\": \"npm install && tsc\",\n    \"build:all\": \"npm run build:backend && npm run build:ui\",\n    \"start\": \"node dist/index.js\",\n    \"dev\": \"ts-node src/index.ts\",\n    \"test\": \"jest\",\n    \"lint\": \"eslint src --ext .ts\",\n    \"type-check\": \"tsc --noEmit\"\n  },\n  \"keywords\": [\n    \"alerts\",\n    \"correlation\",\n    \"troubleshooting\",\n    \"extreme-networks\",\n    \"monitoring\"\n  ],\n  \"author\": \"\",\n  \"license\": \"Apache-2.0\",\n  \"dependencies\": {\n    \"express\": \"^4.18.2\",\n    \"axios\": \"^1.6.0\",\n    \"uuid\": \"^9.0.0\",\n    \"dotenv\": \"^16.3.1\"\n  },\n  \"devDependencies\": {\n    \"@types/express\": \"^4.17.17\",\n    \"@types/node\": \"^20.0.0\",\n    \"@types/uuid\": \"^9.0.2\",\n    \"typescript\": \"^4.9.5\",\n    \"ts-node\": \"^10.9.1\",\n    \"@types/jest\": \"^29.5.2\",\n    \"jest\": \"^29.5.0\",\n    \"ts-jest\": \"^29.1.0\",\n    \"simple-statistics\": \"^7.8.3\",\n    \"ml-kmeans\": \"^4.1.1\",\n    \"eslint\": \"^8.43.0\",\n    \"@typescript-eslint/eslint-plugin\": \"^5.59.6\",\n    \"@typescript-eslint/parser\": \"^5.59.6\"\n  }\n}\n
